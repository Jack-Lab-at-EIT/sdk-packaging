# Map CMake's host platform values to the SDK archive triple.
function(sdk_platform_triple out_var)
  string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _proc)
  if(_proc MATCHES "^(amd64|x86_64)$")
    set(_arch x86_64)
  elseif(_proc MATCHES "^(arm64|aarch64)$")
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
      set(_arch aarch64)
    else()
      set(_arch arm64)
    endif()
  else()
    message(FATAL_ERROR "Unsupported SDK processor: ${CMAKE_SYSTEM_PROCESSOR}")
  endif()

  if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
    set(_os macos)
  elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(_os linux)
  elseif(CMAKE_SYSTEM_NAME STREQUAL "Windows")
    set(_os windows)
  else()
    message(FATAL_ERROR "Unsupported SDK platform: ${CMAKE_SYSTEM_NAME}")
  endif()

  set(${out_var} "${_os}-${_arch}" PARENT_SCOPE)
endfunction()
